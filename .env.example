# GovResolve MVP - copie para .env na raiz do repositorio
# NUNCA envie o arquivo .env com chaves para o GitHub.
APP_NAME=GovResolve
ENV=development
DEBUG=True
# Permite escolher perfil e orgao sem credenciais somente em desenvolvimento.
DEMO_MODE=True
HOST=0.0.0.0
PORT=8000

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Acesso demonstrativo de servidores; necessario para usar a aba administrativa.
DEMO_STAFF_ACCESS_CODE=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./data/govresolve.db
AGENT_MEMORY_DIR=./data/agent_memory

# OmniRoute, rodando diretamente no computador.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODELS=ddgw/mistral-small-2603,ddgw/gpt-5.4-mini,ddgw/gpt-5.4-nano,uq/turboderp/Qwen3.8-27B-exl3,ddgw/tinfoil/gemma4-31b
# No Docker, localhost aponta para o container. Use o host abaixo quando aplicavel.
OMNIROUTE_DOCKER_BASE_URL=http://host.docker.internal:20128/v1

# Fallback Gemini opcional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco usado no Docker Compose, independente do SQLite local.
POSTGRES_USER=govresolve
POSTGRES_PASSWORD=
POSTGRES_DB=govresolve_db

# Servicos desativados/simulados por padrao no MVP academico.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=
GOVBR_AUTH_URL=
GOVBR_TOKEN_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notificacoes@govresolve.com.br
SMTP_USE_TLS=False
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ==============================================================================
# GovResolve - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e ajuste conforme seu ambiente local
# ==============================================================================

# Configurações da Aplicação
APP_NAME=GovResolve
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de Dados
# SQLite para desenvolvimento local:
DATABASE_URL=sqlite+aiosqlite:///./govresolve.db
# PostgreSQL para ambiente containerizado/produção:
# DATABASE_URL=postgresql+asyncpg://govresolve:govresolve@db:5432/govresolve_db

# Integração com Gov.br (Autenticação Cidadão - RF001)
GOVBR_CLIENT_ID=exemplo_client_id
GOVBR_CLIENT_SECRET=exemplo_client_secret
GOVBR_REDIRECT_URI=http://localhost:8000/api/v1/auth/govbr/callback
GOVBR_AUTH_URL=https://sso.staging.acesso.gov.br/authorize
GOVBR_TOKEN_URL=https://sso.staging.acesso.gov.br/token

# Inteligência Artificial (Triagem, Autoatendimento e Classificação - RF006, RF007, RF008, RF009)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Serviço de Notificações por E-mail (RF005, RNF005)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@govresolve.com.br
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM_EMAIL=notificacoes@govresolve.com.br
SMTP_USE_TLS=True

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
